---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Aescent Web Studio builds deliberate, conversion-focused web experiences for ambitious local businesses.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to Content</a>

    <header class="site-header" data-site-header>
      <a class="brand" href="#top" aria-label="Aescent Web Studio, home" translate="no">
        <span class="brand-gem" aria-hidden="true"></span>
        <span>Aescent</span>
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
        <span>Menu</span>
        <i aria-hidden="true"></i>
      </button>

      <nav id="site-navigation" class="site-nav" aria-label="Primary navigation">
        <a href="#philosophy">Philosophy</a>
        <a href="#work">Work</a>
        <a href="#process">Process</a>
        <a class="nav-cta" href="#estimator">Estimate a Project</a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-lead">
        <span class="footer-index">A / 2026</span>
        <p>Digital craftsmanship,<br /><em>deliberately built.</em></p>
      </div>
      <div class="footer-meta">
        <div>
          <span>Studio</span>
          <a href="#philosophy">Philosophy</a>
          <a href="#work">Selected Work</a>
          <a href="#estimator">Project Estimator</a>
        </div>
        <div>
          <span>Contact</span>
          <a href="mailto:dian.aescentweb@gmail.com">dian.aescentweb@gmail.com</a>
          <p>Calamba, Laguna<br />Philippines</p>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Aescent Web Studio</span>
        <span>Independent Design &amp; Development Studio</span>
      </div>
    </footer>

    <script>
      import { initMotion } from '../scripts/motion';

      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('.site-nav');

      const closeMenu = () => {
        menu?.setAttribute('aria-expanded', 'false');
        nav?.classList.remove('is-open');
      };

      menu?.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') === 'true';
        menu.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('is-open', !open);
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      initMotion();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #0a0a0a;
    --paper: #fbfbfb;
    --gold: #d4af37;
    --muted: #9b9993;
    --faint: #55534f;
    --line: #282724;
    --page-pad: clamp(1.25rem, 4vw, 4.5rem);
    --max-width: 92rem;
    --font-body: 'Manrope', sans-serif;
    --font-display: 'Space Grotesk', sans-serif;
    color-scheme: dark;
    font-family: var(--font-body);
    color: var(--paper);
    background: var(--ink);
    font-synthesis: none;
  }

  * { box-sizing: border-box; }
  html { background: var(--ink); }
  body { min-width: 20rem; margin: 0; overflow-x: hidden; background: var(--ink); }
  body, button, input, textarea, select { font-family: var(--font-body); }
  h1, h2, h3, h4, h5, h6 { font-family: var(--font-display); }
  h1 em, h2 em, h3 em, h4 em, h5 em, h6 em { font-style: normal; }
  a { color: inherit; text-decoration: none; }
  button, a, input { -webkit-tap-highlight-color: rgb(212 175 55 / 18%); }
  button, input { touch-action: manipulation; }
  img, canvas { display: block; max-width: 100%; }
  ::selection { color: var(--ink); background: var(--gold); }

  :focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }

  .skip-link {
    position: fixed;
    z-index: 1000;
    top: 1rem;
    left: 1rem;
    padding: .75rem 1rem;
    color: var(--ink);
    background: var(--gold);
    font-size: .75rem;
    font-weight: 600;
    transform: translateY(-200%);
    transition: transform 180ms ease;
  }
  .skip-link:focus { transform: translateY(0); }

  .site-header {
    position: fixed;
    z-index: 100;
    top: 1rem;
    right: var(--page-pad);
    left: var(--page-pad);
    min-height: 4rem;
    padding: .65rem .75rem .65rem 1.15rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid rgb(251 251 251 / 12%);
    color: var(--paper);
    background: rgb(10 10 10 / 72%);
    backdrop-filter: blur(18px);
    transition: background-color 200ms ease, border-color 200ms ease, transform 300ms ease;
  }
  .site-header.is-scrolled { border-color: rgb(212 175 55 / 28%); background: rgb(10 10 10 / 92%); }
  .brand { min-height: 2.75rem; display: inline-flex; align-items: center; gap: .75rem; font-size: .72rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; }
  .brand-gem { width: .48rem; height: .48rem; background: var(--gold); transform: rotate(45deg); transition: transform 240ms ease; }
  .brand:hover .brand-gem { transform: rotate(135deg); }
  .site-nav { display: flex; align-items: center; gap: clamp(1.25rem, 2.6vw, 3rem); }
  .site-nav a { position: relative; min-height: 2.75rem; display: inline-flex; align-items: center; color: var(--muted); font-size: .66rem; font-weight: 500; letter-spacing: .13em; text-transform: uppercase; transition: color 180ms ease; }
  .site-nav a:hover { color: var(--paper); }
  .site-nav .nav-cta { padding: 0 1.15rem; color: var(--ink); background: var(--gold); }
  .site-nav .nav-cta:hover { color: var(--ink); background: var(--paper); }
  .menu-toggle { display: none; }

  .site-footer { padding: 8rem var(--page-pad) 2rem; border-top: 1px solid var(--line); }
  .footer-lead, .footer-meta, .footer-bottom { width: min(100%, var(--max-width)); margin-inline: auto; }
  .footer-lead { min-height: 23rem; display: flex; align-items: flex-start; justify-content: space-between; }
  .footer-index { color: var(--gold); font-size: .65rem; letter-spacing: .18em; text-transform: uppercase; }
  .footer-lead p { max-width: 10ch; margin: 0; font: 400 clamp(4rem, 9vw, 9rem)/.82 var(--font-display); letter-spacing: -.055em; text-align: right; }
  .footer-lead em { color: var(--muted); font-weight: 400; }
  .footer-meta { padding: 2.5rem 0; display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; border-top: 1px solid var(--line); }
  .footer-meta > div { display: flex; flex-direction: column; align-items: flex-start; gap: .8rem; }
  .footer-meta > div:last-child { align-items: flex-end; text-align: right; }
  .footer-meta span { margin-bottom: .6rem; color: var(--gold); font-size: .62rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  .footer-meta a, .footer-meta p { margin: 0; color: var(--muted); font-size: .8rem; line-height: 1.65; transition: color 180ms ease; }
  .footer-meta a:hover { color: var(--paper); }
  .footer-bottom { padding-top: 1.5rem; display: flex; justify-content: space-between; border-top: 1px solid var(--line); color: var(--faint); font-size: .58rem; letter-spacing: .12em; text-transform: uppercase; }

  @media (max-width: 48rem) {
    .site-header { top: .65rem; min-height: 3.5rem; }
    .menu-toggle { min-width: 3rem; min-height: 2.75rem; padding: 0 .65rem; display: inline-flex; align-items: center; gap: .65rem; border: 0; color: var(--paper); background: transparent; cursor: pointer; font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; }
    .menu-toggle i, .menu-toggle i::after { display: block; width: 1rem; height: 1px; background: currentColor; transition: transform 180ms ease; }
    .menu-toggle i { position: relative; }
    .menu-toggle i::after { content: ''; position: absolute; top: .3rem; }
    .menu-toggle[aria-expanded='true'] i { transform: rotate(45deg); }
    .menu-toggle[aria-expanded='true'] i::after { top: 0; transform: rotate(90deg); }
    .site-nav { position: absolute; top: calc(100% + .5rem); right: 0; left: 0; padding: 1rem; display: none; align-items: stretch; flex-direction: column; gap: 0; border: 1px solid var(--line); background: rgb(10 10 10 / 98%); }
    .site-nav.is-open { display: flex; }
    .site-nav a { min-height: 3.25rem; padding-inline: .75rem; border-bottom: 1px solid var(--line); }
    .site-nav .nav-cta { margin-top: .75rem; justify-content: center; border: 0; }
    .footer-lead { min-height: 18rem; flex-direction: column; gap: 3rem; }
    .footer-lead p { align-self: flex-end; font-size: clamp(3.7rem, 17vw, 5.4rem); }
    .footer-meta { grid-template-columns: 1fr; }
    .footer-meta > div:last-child { align-items: flex-start; text-align: left; }
    .footer-bottom { flex-direction: column; gap: .75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  }
</style>
