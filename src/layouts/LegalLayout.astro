---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#legal-content">Skip to content</a>

    <header class="legal-header">
      <a class="brand" href="/" aria-label="Aescent Web Studio, home">
        <span aria-hidden="true"></span>
        Aescent Web Studio
      </a>
      <a class="return-link" href="/">Back to studio <span aria-hidden="true">↗</span></a>
    </header>

    <main id="legal-content">
      <slot />
    </main>

    <nav class="legal-footer" aria-label="Legal pages">
      <span>© 2026 Aescent Web Studio</span>
      <div>
        <a href="/privacy">Privacy Notice</a>
        <a href="/terms">Terms of Use</a>
      </div>
    </nav>
  </body>
</html>

<style is:global>
  :root {
    --ink: #0a0a0a;
    --paper: #fbfbfb;
    --gold: #d4af37;
    --muted: #9b9993;
    --line: #282724;
    color-scheme: dark;
    font-family: 'Manrope', sans-serif;
    color: var(--paper);
    background: var(--ink);
  }

  * { box-sizing: border-box; }
  html { background: var(--ink); scroll-behavior: smooth; }
  body { min-width: 20rem; margin: 0; background: var(--ink); }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }
  .skip-link { position: fixed; z-index: 10; top: 1rem; left: 1rem; padding: .75rem 1rem; color: var(--ink); background: var(--gold); transform: translateY(-180%); }
  .skip-link:focus { transform: none; }

  .legal-header, .legal-footer { width: min(100% - 2.5rem, 76rem); margin-inline: auto; display: flex; align-items: center; justify-content: space-between; }
  .legal-header { min-height: 6rem; border-bottom: 1px solid var(--line); }
  .brand, .return-link, .legal-footer { font-size: .65rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .brand { display: inline-flex; align-items: center; gap: .75rem; }
  .brand > span { width: .48rem; height: .48rem; background: var(--gold); transform: rotate(45deg); }
  .return-link { color: var(--muted); }
  .return-link:hover, .legal-footer a:hover { color: var(--gold); }

  .legal-document { width: min(100% - 2.5rem, 76rem); margin-inline: auto; padding: clamp(5rem, 10vw, 9rem) 0; display: grid; grid-template-columns: minmax(12rem, .65fr) minmax(0, 1.35fr); gap: clamp(3rem, 9vw, 9rem); }
  .legal-intro { position: sticky; top: 3rem; align-self: start; }
  .legal-kicker { color: var(--gold); font-size: .62rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; }
  .legal-intro h1 { margin: 1.5rem 0 2rem; font: 500 clamp(3.8rem, 7vw, 7rem)/.84 'Space Grotesk', sans-serif; letter-spacing: -.065em; }
  .legal-meta { margin: 0; color: var(--muted); font-size: .72rem; line-height: 1.9; }
  .legal-meta a { color: var(--paper); }

  .legal-copy { counter-reset: legal-section; }
  .legal-copy > p:first-child { margin-top: 0; color: var(--paper); font-size: 1.05rem; line-height: 1.85; }
  .legal-copy h2 { margin: 4rem 0 1.25rem; padding-top: 1.5rem; border-top: 1px solid var(--line); font: 500 clamp(1.4rem, 2vw, 1.85rem)/1.2 'Space Grotesk', sans-serif; letter-spacing: -.025em; }
  .legal-copy p, .legal-copy li { color: var(--muted); font-size: .88rem; line-height: 1.85; }
  .legal-copy ul { padding-left: 1.25rem; }
  .legal-copy li { margin-bottom: .65rem; padding-left: .35rem; }
  .legal-copy strong, .legal-copy a { color: var(--paper); }
  .legal-copy a { text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: .25rem; }

  .legal-footer { min-height: 7rem; border-top: 1px solid var(--line); color: var(--muted); }
  .legal-footer div { display: flex; gap: 2rem; }

  @media (max-width: 48rem) {
    .legal-header { min-height: 5rem; }
    .brand { font-size: .58rem; }
    .return-link { font-size: 0; }
    .return-link span { font-size: .9rem; }
    .legal-document { padding: 4rem 0 6rem; display: block; }
    .legal-intro { position: relative; top: auto; margin-bottom: 5rem; }
    .legal-intro h1 { font-size: clamp(3.7rem, 18vw, 5.5rem); }
    .legal-copy h2 { margin-top: 3rem; }
    .legal-footer { padding: 2rem 0; align-items: flex-start; gap: 2rem; flex-direction: column; }
  }

  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
