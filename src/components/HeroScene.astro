---
import { Image } from 'astro:assets';
import abstractMark from '../assets/aescent-logo-abstract.webp';
import AescentThreshold from './hero/AescentThreshold';
---

<div class="scene" data-hero-scene>
  <div class="scene-fallback" data-scene-fallback aria-hidden="true">
    <Image
      src={abstractMark}
      alt=""
      width={720}
      height={720}
      quality={72}
      format="webp"
    />
  </div>
  <AescentThreshold client:only="react" />
  <div class="scene-grid" aria-hidden="true"></div>
  <span class="scene-label scene-label-top">Aescent / Threshold 01</span>
</div>

<style>
  .scene { position: absolute; inset: 0; overflow: hidden; background: #050505; }
  .scene :global(.threshold-react-root), .scene :global(canvas) { width: 100%; height: 100%; display: block; }
  .scene :global(.threshold-react-root) { position: absolute; inset: 0; }
  .scene-fallback { position: absolute; inset: 0; display: grid; place-items: center; background: #050505; opacity: 1; transition: opacity 500ms ease; }
  .scene-fallback :global(img) { width: min(48vw, 38rem); height: auto; opacity: .9; }
  .scene.is-ready .scene-fallback { opacity: 0; pointer-events: none; }
  .scene-grid { position: absolute; inset: 0; pointer-events: none; opacity: .25; background-image: linear-gradient(rgb(212 175 55 / 9%) 1px, transparent 1px), linear-gradient(90deg, rgb(212 175 55 / 9%) 1px, transparent 1px); background-size: 6rem 6rem; mask-image: linear-gradient(90deg, transparent 0 38%, black 62% 100%); }
  .scene-label { position: absolute; z-index: 2; color: #77746c; font-size: .52rem; letter-spacing: .17em; text-transform: uppercase; pointer-events: none; }
  .scene-label-top { top: clamp(10.5rem, 18vh, 13rem); right: var(--page-pad); }

  @media (max-width: 48rem) {
    .scene { position: relative; min-height: 31rem; }
    .scene-fallback :global(img) { width: min(80vw, 27rem); }
    .scene-grid { background-size: 4rem 4rem; mask-image: linear-gradient(transparent, black); }
    .scene-label-top { top: 1.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-fallback { transition: none; }
  }
</style>
