<div class="scene" data-hero-scene>
  <canvas data-hero-canvas aria-hidden="true"></canvas>
  <div class="scene-fallback" data-scene-fallback aria-hidden="true">
    <img src="/assets/aescent_logo_monogram_transparent.png" alt="Aescent Web Studio" class="fallback-logo" />
  </div>
  <div class="scene-axis axis-x" aria-hidden="true"></div>
  <div class="scene-axis axis-y" aria-hidden="true"></div>
  <span class="scene-label scene-label-top">Aescent / Identity</span>
  <span class="scene-label scene-label-bottom">Scroll to Rotate</span>
</div>

<script>
  import {
    BoxGeometry,
    DirectionalLight,
    EdgesGeometry,
    Group,
    HemisphereLight,
    LineBasicMaterial,
    LineSegments,
    MathUtils,
    Mesh,
    MeshBasicMaterial,
    MeshPhysicalMaterial,
    PerspectiveCamera,
    PointLight,
    Scene,
    SRGBColorSpace,
    TorusGeometry,
    WebGLRenderer,
  } from 'three';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const shell = document.querySelector<HTMLElement>('[data-hero-scene]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const fallback = document.querySelector<HTMLElement>('[data-scene-fallback]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (shell && canvas && hero) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    let renderer: WebGLRenderer | undefined;
    let resizeObserver: ResizeObserver | undefined;
    let visibilityObserver: IntersectionObserver | undefined;
    let frame = 0;
    let visible = true;
    let progress = 0;
    const pointer = { x: 0, y: 0 };
    const target = { x: 0, y: 0 };

    try {
      renderer = new WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'high-performance' });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
      renderer.setClearColor(0x000000, 0);
      renderer.outputColorSpace = SRGBColorSpace;

      const scene = new Scene();
      const camera = new PerspectiveCamera(32, 1, 0.1, 100);
      camera.position.set(0, 0.15, 7.4);

      const monolith = new Group();
      scene.add(monolith);

      const darkMaterial = new MeshPhysicalMaterial({
        color: 0x11110f,
        metalness: 0.82,
        roughness: 0.24,
        clearcoat: 0.85,
        clearcoatRoughness: 0.18,
      });
      const goldMaterial = new LineBasicMaterial({ color: 0xd4af37, transparent: true, opacity: 0.72 });

      const addBeam = (geometry: BoxGeometry, x: number, y: number, rotation: number) => {
        const mesh = new Mesh(geometry, darkMaterial);
        mesh.position.set(x, y, 0);
        mesh.rotation.z = rotation;
        monolith.add(mesh);
        const edges = new LineSegments(new EdgesGeometry(geometry), goldMaterial);
        edges.position.copy(mesh.position);
        edges.rotation.copy(mesh.rotation);
        monolith.add(edges);
      };

      addBeam(new BoxGeometry(0.48, 4.2, 0.56, 2, 2, 2), -0.72, 0, -0.34);
      addBeam(new BoxGeometry(0.48, 4.2, 0.56, 2, 2, 2), 0.72, 0, 0.34);
      addBeam(new BoxGeometry(1.55, 0.34, 0.6, 2, 2, 2), 0, -0.28, 0);

      const frameGeometry = new TorusGeometry(2.45, 0.012, 6, 96);
      const orbit = new Mesh(frameGeometry, new MeshBasicMaterial({ color: 0xd4af37, transparent: true, opacity: 0.24 }));
      orbit.rotation.x = Math.PI / 2.35;
      orbit.position.z = -0.9;
      scene.add(orbit);

      scene.add(new HemisphereLight(0xfbfbfb, 0x0a0a0a, 1.4));
      const key = new DirectionalLight(0xfbfbfb, 4.2);
      key.position.set(-3, 4, 5);
      scene.add(key);
      const rim = new PointLight(0xd4af37, 45, 12, 2);
      rim.position.set(3.5, -1.5, 3);
      scene.add(rim);

      const resize = () => {
        if (!renderer) return;
        const { width, height } = shell.getBoundingClientRect();
        renderer.setSize(Math.max(width, 1), Math.max(height, 1), false);
        camera.aspect = Math.max(width, 1) / Math.max(height, 1);
        camera.updateProjectionMatrix();
      };
      resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(shell);
      resize();

      const render = () => {
        if (!renderer) return;
        pointer.x += (target.x - pointer.x) * 0.055;
        pointer.y += (target.y - pointer.y) * 0.055;
        monolith.rotation.y = pointer.x + progress * 0.46;
        monolith.rotation.x = pointer.y - progress * 0.12;
        monolith.position.y = progress * -0.32;
        orbit.rotation.z = progress * 0.3;
        camera.position.z = 7.4 - progress * 0.6;
        renderer.render(scene, camera);
        if (!reduceMotion && visible) frame = requestAnimationFrame(render);
      };

      const onPointerMove = (event: PointerEvent) => {
        const rect = shell.getBoundingClientRect();
        target.x = ((event.clientX - rect.left) / rect.width - 0.5) * MathUtils.degToRad(8);
        target.y = ((event.clientY - rect.top) / rect.height - 0.5) * MathUtils.degToRad(-8);
      };
      const onPointerLeave = () => { target.x = 0; target.y = 0; };
      if (finePointer && !reduceMotion) {
        shell.addEventListener('pointermove', onPointerMove);
        shell.addEventListener('pointerleave', onPointerLeave);
      }

      const trigger = !reduceMotion ? ScrollTrigger.create({
        trigger: hero,
        start: 'top top',
        end: 'bottom top',
        scrub: 0.8,
        onUpdate: (self) => { progress = self.progress; },
      }) : undefined;

      visibilityObserver = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting && !document.hidden;
        cancelAnimationFrame(frame);
        if (visible && !reduceMotion) frame = requestAnimationFrame(render);
      }, { rootMargin: '20%' });
      visibilityObserver.observe(shell);

      const onVisibility = () => {
        visible = !document.hidden && hero.getBoundingClientRect().bottom > 0;
        cancelAnimationFrame(frame);
        if (visible && !reduceMotion) frame = requestAnimationFrame(render);
      };
      document.addEventListener('visibilitychange', onVisibility);
      fallback?.setAttribute('hidden', '');
      render();

      window.addEventListener('pagehide', () => {
        cancelAnimationFrame(frame);
        trigger?.kill();
        resizeObserver?.disconnect();
        visibilityObserver?.disconnect();
        document.removeEventListener('visibilitychange', onVisibility);
        shell.removeEventListener('pointermove', onPointerMove);
        shell.removeEventListener('pointerleave', onPointerLeave);
        frameGeometry.dispose();
        darkMaterial.dispose();
        goldMaterial.dispose();
        scene.traverse((object) => {
          if (object instanceof Mesh || object instanceof LineSegments) {
            object.geometry?.dispose();
          }
        });
        renderer?.dispose();
      }, { once: true });
    } catch {
      canvas.hidden = true;
      fallback?.removeAttribute('hidden');
      renderer?.dispose();
    }
  }
</script>

<style>
  .scene { position: relative; width: 100%; height: 100%; min-height: 28rem; overflow: hidden; border: 1px solid var(--line); background: radial-gradient(circle at 70% 35%, #1a1812 0, #0d0d0c 36%, #080808 72%); }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .scene-fallback { position: absolute; inset: 0; display: grid; place-items: center; }
  .fallback-logo { max-width: clamp(12rem, 28vw, 22rem); height: auto; filter: drop-shadow(0 0 2rem rgba(212, 175, 55, 0.15)); }
  .scene-axis { position: absolute; pointer-events: none; background: rgb(251 251 251 / 9%); }
  .axis-x { top: 50%; right: 2rem; left: 2rem; height: 1px; }
  .axis-y { top: 2rem; bottom: 2rem; left: 50%; width: 1px; }
  .scene-label { position: absolute; z-index: 2; color: var(--muted); font-size: .55rem; letter-spacing: .18em; text-transform: uppercase; }
  .scene-label-top { top: 1.5rem; left: 1.5rem; }
  .scene-label-bottom { right: 1.5rem; bottom: 1.5rem; }
  @media (max-width: 48rem) { .scene { min-height: 25rem; } .scene-label-bottom { display: none; } }
  @media (prefers-reduced-motion: reduce) { canvas { opacity: .8; } }
</style>
