---
import { portfolioChapters } from '../scripts/chapterNavigation';
---

<nav class="chapter-rail" aria-label="Page chapters" data-chapter-rail>
  <div class="chapter-rail__counter" aria-hidden="true">
    <span data-chapter-current>01</span>
    <i></i>
    <span>{String(portfolioChapters.length).padStart(2, '0')}</span>
  </div>

  <ol>
    {portfolioChapters.map((chapter) => (
      <li>
        <a href={`#${chapter.id}`} data-chapter-link data-chapter-id={chapter.id} aria-label={chapter.label}>
          <span class="chapter-rail__number" aria-hidden="true">{chapter.number}</span>
          <span class="chapter-rail__label">{chapter.shortLabel}</span>
          <i class="chapter-rail__marker" aria-hidden="true"></i>
        </a>
      </li>
    ))}
  </ol>

  <div class="chapter-rail__progress" aria-hidden="true"><i></i></div>
</nav>

<style>
  .chapter-rail {
    --page-progress: 0;
    position: fixed;
    z-index: 90;
    right: max(1.5rem, env(safe-area-inset-right));
    bottom: max(2rem, env(safe-area-inset-bottom));
    width: min(12.5rem, calc(100vw - 3rem));
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.25rem .9rem;
    color: var(--muted);
    font-size: .6rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    opacity: .25;
    transition: opacity 260ms ease, transform 260ms ease, visibility 260ms ease;
    pointer-events: auto;
  }
  .chapter-rail:hover { opacity: 1; }
  .chapter-rail.is-hidden { visibility: hidden; opacity: 0; pointer-events: none; transform: translateY(.75rem); }
  .chapter-rail__counter { grid-column: 1; display: flex; align-items: center; justify-content: flex-end; gap: .45rem; color: var(--paper); font-variant-numeric: tabular-nums; }
  .chapter-rail__counter i { width: 1.5rem; height: 1px; background: var(--line); }
  ol { grid-column: 1; margin: 0; padding: 0; display: grid; gap: .35rem; list-style: none; }
  a { min-height: 2.75rem; display: grid; grid-template-columns: 1.9rem minmax(0, 1fr) .45rem; align-items: center; gap: .45rem; color: inherit; transition: color 180ms ease, transform 180ms ease; }
  a:hover { color: var(--paper); transform: translateX(-.2rem); }
  a:focus-visible { outline-offset: 5px; }
  .chapter-rail__number { color: var(--faint); font-variant-numeric: tabular-nums; transition: color 180ms ease; }
  .chapter-rail__label { justify-self: end; transition: color 180ms ease, font-weight 180ms ease; }
  .chapter-rail__marker { width: .38rem; height: .38rem; border: 1px solid currentColor; transform: rotate(45deg); transition: background-color 180ms ease, border-color 180ms ease, transform 180ms ease; }
  a[aria-current='location'] { color: var(--paper); transform: translateX(-.35rem); }
  a[aria-current='location'] .chapter-rail__number { color: var(--gold); }
  a[aria-current='location'] .chapter-rail__label { font-weight: 700; }
  a[aria-current='location'] .chapter-rail__marker { border-color: var(--gold); background: var(--gold); transform: rotate(45deg) scale(1.15); }
  .chapter-rail__progress { grid-column: 2; grid-row: 1 / span 2; width: 1px; margin: .1rem .2rem 0 0; background: var(--line); }
  .chapter-rail__progress i { width: 100%; height: 100%; display: block; background: var(--gold); transform: scaleY(var(--page-progress)); transform-origin: top; }

  @media (max-width: 64rem) {
    .chapter-rail { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chapter-rail, a, .chapter-rail__number, .chapter-rail__label, .chapter-rail__marker { transition: none; }
  }
</style>
